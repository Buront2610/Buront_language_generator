{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "version",
    "kind",
    "factId",
    "clauses",
    "evidenceTokens",
    "conditions",
    "certainty",
    "provenance"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "number"
    },
    "kind": {
      "anyOf": [
        {
          "const": "explicit-reason",
          "type": "string"
        },
        {
          "const": "explicit-contrast",
          "type": "string"
        },
        {
          "const": "modest-achievement",
          "type": "string"
        }
      ]
    },
    "factId": {
      "type": "string"
    },
    "clauses": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "span",
          "tokenIds"
        ],
        "properties": {
          "role": {
            "anyOf": [
              {
                "const": "claim",
                "type": "string"
              },
              {
                "const": "reason",
                "type": "string"
              },
              {
                "const": "antecedent",
                "type": "string"
              },
              {
                "const": "contrast",
                "type": "string"
              },
              {
                "const": "modesty",
                "type": "string"
              },
              {
                "const": "achievement",
                "type": "string"
              }
            ]
          },
          "span": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "minimum": 0,
                "type": "integer"
              },
              "end": {
                "minimum": 0,
                "type": "integer"
              }
            }
          },
          "tokenIds": {
            "type": "array",
            "items": {
              "minimum": 0,
              "type": "integer"
            }
          }
        }
      }
    },
    "evidenceTokens": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "tokenId",
          "span"
        ],
        "properties": {
          "role": {
            "anyOf": [
              {
                "const": "predicate",
                "type": "string"
              },
              {
                "const": "marker",
                "type": "string"
              },
              {
                "const": "past",
                "type": "string"
              },
              {
                "const": "limit",
                "type": "string"
              },
              {
                "const": "copula",
                "type": "string"
              }
            ]
          },
          "tokenId": {
            "minimum": 0,
            "type": "integer"
          },
          "span": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "minimum": 0,
                "type": "integer"
              },
              "end": {
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "predicateTokenId",
          "factId",
          "polarity",
          "tense",
          "realization",
          "completion",
          "voice",
          "attribution",
          "conditional",
          "speculative",
          "prospective",
          "ambiguous",
          "nonDeclarative",
          "reportedContent"
        ],
        "properties": {
          "predicateTokenId": {
            "minimum": 0,
            "type": "integer"
          },
          "factId": {
            "type": "string"
          },
          "polarity": {
            "anyOf": [
              {
                "const": "positive",
                "type": "string"
              },
              {
                "const": "negative",
                "type": "string"
              },
              {
                "const": "unknown",
                "type": "string"
              }
            ]
          },
          "tense": {
            "anyOf": [
              {
                "const": "past",
                "type": "string"
              },
              {
                "const": "nonpast",
                "type": "string"
              },
              {
                "const": "unknown",
                "type": "string"
              }
            ]
          },
          "realization": {
            "anyOf": [
              {
                "const": "actual",
                "type": "string"
              },
              {
                "const": "prospective",
                "type": "string"
              },
              {
                "const": "hypothetical",
                "type": "string"
              },
              {
                "const": "unknown",
                "type": "string"
              }
            ]
          },
          "completion": {
            "anyOf": [
              {
                "const": "completed",
                "type": "string"
              },
              {
                "const": "ongoing",
                "type": "string"
              },
              {
                "const": "not_completed",
                "type": "string"
              },
              {
                "const": "unknown",
                "type": "string"
              }
            ]
          },
          "voice": {
            "anyOf": [
              {
                "const": "active",
                "type": "string"
              },
              {
                "const": "passive",
                "type": "string"
              },
              {
                "const": "unknown",
                "type": "string"
              }
            ]
          },
          "attribution": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "speaker"
            ],
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "const": "narrator",
                    "type": "string"
                  },
                  {
                    "const": "quotation",
                    "type": "string"
                  },
                  {
                    "const": "hearsay",
                    "type": "string"
                  }
                ]
              },
              "speaker": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "conditional": {
            "type": "boolean"
          },
          "speculative": {
            "type": "boolean"
          },
          "prospective": {
            "type": "boolean"
          },
          "ambiguous": {
            "type": "boolean"
          },
          "nonDeclarative": {
            "type": "boolean"
          },
          "reportedContent": {
            "type": "boolean"
          }
        }
      }
    },
    "certainty": {
      "const": "explicit",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "inputHash",
        "parserVersion"
      ],
      "properties": {
        "inputHash": {
          "type": "string"
        },
        "parserVersion": {
          "type": "string"
        }
      }
    }
  }
}
