{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "version",
    "seriesId",
    "intensity",
    "edits",
    "lexicalEdits"
  ],
  "properties": {
    "version": {
      "const": 2,
      "type": "number"
    },
    "seriesId": {
      "type": "string"
    },
    "intensity": {
      "minimum": 1,
      "maximum": 3,
      "type": "integer"
    },
    "edits": {
      "maxItems": 12000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nodeId",
          "sourceSpan",
          "operation",
          "constructionId",
          "constructionVersion",
          "realizationId",
          "factId",
          "from",
          "to",
          "evidenceIds",
          "bindings",
          "features"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "sourceSpan": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "minimum": 0,
                "type": "integer"
              },
              "end": {
                "minimum": 0,
                "type": "integer"
              }
            }
          },
          "operation": {
            "anyOf": [
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "replace",
                    "type": "string"
                  }
                }
              },
              {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "kind",
                  "prefix",
                  "bodySourceSpan",
                  "permittedLocalEdits"
                ],
                "properties": {
                  "kind": {
                    "const": "prefix_source_body",
                    "type": "string"
                  },
                  "prefix": {
                    "type": "string"
                  },
                  "bodySourceSpan": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "start",
                      "end"
                    ],
                    "properties": {
                      "start": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "end": {
                        "minimum": 0,
                        "type": "integer"
                      }
                    }
                  },
                  "permittedLocalEdits": {
                    "const": "independently_verified_rewrites",
                    "type": "string"
                  }
                }
              }
            ]
          },
          "relation": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "version",
              "kind",
              "factId",
              "clauses",
              "evidenceTokens",
              "conditions",
              "certainty",
              "provenance"
            ],
            "properties": {
              "version": {
                "const": 1,
                "type": "number"
              },
              "kind": {
                "anyOf": [
                  {
                    "const": "explicit-reason",
                    "type": "string"
                  },
                  {
                    "const": "explicit-contrast",
                    "type": "string"
                  },
                  {
                    "const": "modest-achievement",
                    "type": "string"
                  }
                ]
              },
              "factId": {
                "type": "string"
              },
              "clauses": {
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "role",
                    "span",
                    "tokenIds"
                  ],
                  "properties": {
                    "role": {
                      "anyOf": [
                        {
                          "const": "claim",
                          "type": "string"
                        },
                        {
                          "const": "reason",
                          "type": "string"
                        },
                        {
                          "const": "antecedent",
                          "type": "string"
                        },
                        {
                          "const": "contrast",
                          "type": "string"
                        },
                        {
                          "const": "modesty",
                          "type": "string"
                        },
                        {
                          "const": "achievement",
                          "type": "string"
                        }
                      ]
                    },
                    "span": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "start",
                        "end"
                      ],
                      "properties": {
                        "start": {
                          "minimum": 0,
                          "type": "integer"
                        },
                        "end": {
                          "minimum": 0,
                          "type": "integer"
                        }
                      }
                    },
                    "tokenIds": {
                      "type": "array",
                      "items": {
                        "minimum": 0,
                        "type": "integer"
                      }
                    }
                  }
                }
              },
              "evidenceTokens": {
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "role",
                    "tokenId",
                    "span"
                  ],
                  "properties": {
                    "role": {
                      "anyOf": [
                        {
                          "const": "predicate",
                          "type": "string"
                        },
                        {
                          "const": "marker",
                          "type": "string"
                        },
                        {
                          "const": "past",
                          "type": "string"
                        },
                        {
                          "const": "limit",
                          "type": "string"
                        },
                        {
                          "const": "copula",
                          "type": "string"
                        }
                      ]
                    },
                    "tokenId": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "span": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "start",
                        "end"
                      ],
                      "properties": {
                        "start": {
                          "minimum": 0,
                          "type": "integer"
                        },
                        "end": {
                          "minimum": 0,
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              },
              "conditions": {
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "predicateTokenId",
                    "factId",
                    "polarity",
                    "tense",
                    "realization",
                    "completion",
                    "voice",
                    "attribution",
                    "conditional",
                    "speculative",
                    "prospective",
                    "ambiguous",
                    "nonDeclarative",
                    "reportedContent"
                  ],
                  "properties": {
                    "predicateTokenId": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "factId": {
                      "type": "string"
                    },
                    "polarity": {
                      "anyOf": [
                        {
                          "const": "positive",
                          "type": "string"
                        },
                        {
                          "const": "negative",
                          "type": "string"
                        },
                        {
                          "const": "unknown",
                          "type": "string"
                        }
                      ]
                    },
                    "tense": {
                      "anyOf": [
                        {
                          "const": "past",
                          "type": "string"
                        },
                        {
                          "const": "nonpast",
                          "type": "string"
                        },
                        {
                          "const": "unknown",
                          "type": "string"
                        }
                      ]
                    },
                    "realization": {
                      "anyOf": [
                        {
                          "const": "actual",
                          "type": "string"
                        },
                        {
                          "const": "prospective",
                          "type": "string"
                        },
                        {
                          "const": "hypothetical",
                          "type": "string"
                        },
                        {
                          "const": "unknown",
                          "type": "string"
                        }
                      ]
                    },
                    "completion": {
                      "anyOf": [
                        {
                          "const": "completed",
                          "type": "string"
                        },
                        {
                          "const": "ongoing",
                          "type": "string"
                        },
                        {
                          "const": "not_completed",
                          "type": "string"
                        },
                        {
                          "const": "unknown",
                          "type": "string"
                        }
                      ]
                    },
                    "voice": {
                      "anyOf": [
                        {
                          "const": "active",
                          "type": "string"
                        },
                        {
                          "const": "passive",
                          "type": "string"
                        },
                        {
                          "const": "unknown",
                          "type": "string"
                        }
                      ]
                    },
                    "attribution": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "kind",
                        "speaker"
                      ],
                      "properties": {
                        "kind": {
                          "anyOf": [
                            {
                              "const": "narrator",
                              "type": "string"
                            },
                            {
                              "const": "quotation",
                              "type": "string"
                            },
                            {
                              "const": "hearsay",
                              "type": "string"
                            }
                          ]
                        },
                        "speaker": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    "conditional": {
                      "type": "boolean"
                    },
                    "speculative": {
                      "type": "boolean"
                    },
                    "prospective": {
                      "type": "boolean"
                    },
                    "ambiguous": {
                      "type": "boolean"
                    },
                    "nonDeclarative": {
                      "type": "boolean"
                    },
                    "reportedContent": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "certainty": {
                "const": "explicit",
                "type": "string"
              },
              "provenance": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "inputHash",
                  "parserVersion"
                ],
                "properties": {
                  "inputHash": {
                    "type": "string"
                  },
                  "parserVersion": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "constructionId": {
            "type": "string"
          },
          "constructionVersion": {
            "anyOf": [
              {
                "const": 1,
                "type": "number"
              },
              {
                "const": 2,
                "type": "number"
              }
            ]
          },
          "realizationId": {
            "type": "string"
          },
          "factId": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "evidenceIds": {
            "maxItems": 12000,
            "type": "array",
            "items": {
              "maxLength": 12000,
              "type": "string"
            }
          },
          "bindings": {
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "slot",
                "span",
                "text",
                "tokenIds"
              ],
              "properties": {
                "slot": {
                  "anyOf": [
                    {
                      "const": "emotion",
                      "type": "string"
                    },
                    {
                      "const": "degree",
                      "type": "string"
                    },
                    {
                      "const": "predicate",
                      "type": "string"
                    },
                    {
                      "const": "marker",
                      "type": "string"
                    },
                    {
                      "const": "experiencer",
                      "type": "string"
                    },
                    {
                      "const": "state",
                      "type": "string"
                    },
                    {
                      "const": "time",
                      "type": "string"
                    },
                    {
                      "const": "claim",
                      "type": "string"
                    },
                    {
                      "const": "reason",
                      "type": "string"
                    },
                    {
                      "const": "antecedent",
                      "type": "string"
                    },
                    {
                      "const": "contrast",
                      "type": "string"
                    },
                    {
                      "const": "modesty",
                      "type": "string"
                    },
                    {
                      "const": "achievement",
                      "type": "string"
                    }
                  ]
                },
                "span": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "start",
                    "end"
                  ],
                  "properties": {
                    "start": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "end": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  }
                },
                "text": {
                  "type": "string"
                },
                "tokenIds": {
                  "maxItems": 12000,
                  "type": "array",
                  "items": {
                    "minimum": 0,
                    "type": "integer"
                  }
                }
              }
            }
          },
          "features": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "polarity",
              "tense",
              "realization",
              "completion",
              "attribution",
              "voice"
            ],
            "properties": {
              "polarity": {
                "anyOf": [
                  {
                    "const": "positive",
                    "type": "string"
                  },
                  {
                    "const": "negative",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              },
              "tense": {
                "anyOf": [
                  {
                    "const": "past",
                    "type": "string"
                  },
                  {
                    "const": "nonpast",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              },
              "realization": {
                "anyOf": [
                  {
                    "const": "actual",
                    "type": "string"
                  },
                  {
                    "const": "prospective",
                    "type": "string"
                  },
                  {
                    "const": "hypothetical",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              },
              "completion": {
                "anyOf": [
                  {
                    "const": "completed",
                    "type": "string"
                  },
                  {
                    "const": "ongoing",
                    "type": "string"
                  },
                  {
                    "const": "not_completed",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              },
              "attribution": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "kind",
                  "speaker"
                ],
                "properties": {
                  "kind": {
                    "anyOf": [
                      {
                        "const": "narrator",
                        "type": "string"
                      },
                      {
                        "const": "quotation",
                        "type": "string"
                      },
                      {
                        "const": "hearsay",
                        "type": "string"
                      }
                    ]
                  },
                  "speaker": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "voice": {
                "anyOf": [
                  {
                    "const": "active",
                    "type": "string"
                  },
                  {
                    "const": "passive",
                    "type": "string"
                  },
                  {
                    "const": "unknown",
                    "type": "string"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "lexicalEdits": {
      "maxItems": 12000,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nodeId",
          "sourceSpan",
          "ruleId",
          "from",
          "to",
          "evidenceIds"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "sourceSpan": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "minimum": 0,
                "type": "integer"
              },
              "end": {
                "minimum": 0,
                "type": "integer"
              }
            }
          },
          "ruleId": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "evidenceIds": {
            "maxItems": 12000,
            "type": "array",
            "items": {
              "maxLength": 12000,
              "type": "string"
            }
          }
        }
      }
    }
  }
}
