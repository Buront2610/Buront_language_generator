  "cases": [
    {
      "id": "N01",
      "category": "日常の手順",
      "source": "私は朝七時に起きて、駅まで歩いた。電車は五分遅れていたが、会議には間に合った。",
      "group": "ordinary"
    },
    {
      "id": "N02",
      "category": "業務連絡と数値",
      "source": "明日の会議は午後三時からです。資料を二部ずつ持ってきてください。",
      "group": "ordinary"
    },
    {
      "id": "N03",
      "category": "根拠を伴う比較",
      "source": "車より電車で行くほうがよいと思う。駐車場を探す必要がなく、到着時刻も読みやすいからだ。",
      "group": "ordinary"
    },
    {
      "id": "N04",
      "category": "反論と根拠",
      "source": "その案には賛成できない。費用が高いだけでなく、準備に一週間もかかるからだ。まず小さく試すべきだと思う。",
      "group": "ordinary"
    },
    {
      "id": "N05",
      "category": "謙遜を伴う達成",
      "source": "大したことはしていない。故障の原因を見つけて、止まっていた機械を動かしただけだ。",
      "group": "ordinary"
    },
    {
      "id": "N06",
      "category": "感謝と対人関係",
      "source": "忙しいのに手伝ってくれてありがとう。おかげで予定より早く作業が終わった。",
      "group": "ordinary"
    },
    {
      "id": "N07",
      "category": "依頼と提案",
      "source": "この箱を一緒に運んでもらえますか。重いので、二人で持ったほうが安全です。",
      "group": "ordinary"
    },
    {
      "id": "N08",
      "category": "情景描写",
      "source": "夕方の川沿いは静かだった。水面に街の明かりが映り、遠くで犬が一度だけ鳴いた。",
      "group": "ordinary"
    },
    {
      "id": "N09",
      "category": "弱い不満",
      "source": "店員に二度説明したのに注文が違っていたので、私は少し腹を立てた。",
      "group": "ordinary"
    },
    {
      "id": "N10",
      "category": "感情の対象",
      "source": "私は友人の引っ越しがとても寂しかった。それでも、新しい町で元気に暮らしてほしいと思った。",
      "group": "ordinary"
    },
    {
      "id": "N11",
      "category": "条件・否定・推量",
      "source": "もし明日雨が降ったら、試合は中止になるかもしれない。まだ決まったわけではないので、道具は片付けないでほしい。",
      "group": "ordinary"
    },
    {
      "id": "N12",
      "category": "引用を含む会話",
      "source": "田中は「今回は私の負けだ」と言った。私は「次は一緒に練習しよう」と答えた。",
